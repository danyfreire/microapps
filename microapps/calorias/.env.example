# Proveedor de IA. Valores: vacío (mock/dev) o "openai".
AI_PROVIDER=

# Clave del proveedor. Si está vacía, se usa el estimador mock/dev (sin IA).
AI_API_KEY=

# Modelo del proveedor (solo se usa con OpenAI).
AI_MODEL=gpt-4o-mini

# Analítica (deshabilitada por defecto). NUNCA enviar texto de comidas ni fotos.
ANALYTICS_ENABLED=false
